# ==========================================
# CAU HINH MOI TRUONG CHO EVENT CHECK-IN API
# Copy file nay thanh .env de he thong hoat dong
# ==========================================

# 1. Thong tin du an
PROJECT_NAME="Event Check-in Enterprise API"

# 2. Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://admin:adminpassword@postgres:5432/event_checkin

# 3. Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# 4. Object Storage (MinIO)
MINIO_URL=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=adminpassword
BUCKET_NAME=event-logs

# 5. Message Queue (RabbitMQ)
MQ_USER=admin
MQ_PASSWORD=adminpassword
MQ_HOST=rabbitmq
